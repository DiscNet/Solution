TOKITO_API=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/3cki3c6xi/

# Opcional: transcrição de áudio. Basta configurar uma das chaves.
GROQ_API_KEY=
OPENAI_API_KEY=

# Opcional: permite ao Akinator continuar a mesma partida após um palpite errado.
# Sem esta chave, o bot inicia automaticamente uma nova rodada se o endpoint de continuação for bloqueado.
AKINATOR_SCRAPER_API_KEY=

# Opcional: persistência das utilidades (notas, favoritos e lembretes).
# Exemplo em um volume Railway: /data/utilidades.json
BOT_UTIL_DATA_PATH=

# Opcional no Railway. Se você montar um volume em /data,
# use AUTH_DIR=/data/auth_info para manter a sessão persistente.
AUTH_DIR=
